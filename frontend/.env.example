# External auth API URL (used by Vite dev proxy — not exposed to the browser)
AUTH_API_URL=https://api.inio.de/auth

# Browser-facing proxy path for auth API calls
VITE_AUTH_API_URL=/ext-auth

# TBA3 report data API URL (used by Vite dev proxy — not exposed to the browser)
TBA3_DATA_API_URL=https://api.inio.de/report_data_tba3

# Browser-facing proxy path for TBA3 data API calls
VITE_TBA3_DATA_API_URL=/ext-tba3

# Following variables are project kompetenztest.de specific to choose correct groups.
# Fixed testgroup-id. Needed for tba3 data api
VITE_TEST_GROUP=270
# Fixed subject test id (Deutsch 8, Testheft A, Thüringen). Needed for tba3 data api.
VITE_TEST_ID=9516
# Math test IDs — a group participates in exactly one of these two.
VITE_MATH_TEST_ID_A=9522
VITE_MATH_TEST_ID_B=9524
# Survey ID for student login
VITE_SURVEY_ID=314
# Enable PDF generation feature (requires the print backend to be running)
VITE_PDF_ENABLED=true
